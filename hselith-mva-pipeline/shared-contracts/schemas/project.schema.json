{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hselith-mva.example/schemas/shared-contracts/project.schema.json",
  "title": "Project",
  "description": "Bioprocess necesita contexto de proyecto por lote; Core lo gestiona en el módulo Proyectos (documento técnico, Sección 3.2). Extensión futura de campos pendiente de confirmar al profundizar Bioprocess (Sección 8).",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "institution_id", "name", "status"],
  "properties": {
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "FK → Institution."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": ["STATUS_ACTIVE", "STATUS_CLOSED"]
    }
  }
}
